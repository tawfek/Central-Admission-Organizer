# Public canonical URL used in print/share output.
# Safe to commit: this is only an example and contains no secret.
NODE_ENV=production
VITE_APP_URL=https://example.com

# Optional HTTPS API origin for secure Telegram account/session integration.
# The server must validate Telegram initData and keep the bot token server-side.
# Leave empty while using the static GitHub Pages-only deployment.
VITE_TELEGRAM_API_URL=
